# MongoDB connection string. The database name can be given separately with
# DATABASE_NAME (defaults to "last-heist").
DATABASE=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/
DATABASE_NAME=last-heist

# Secret used to sign the session cookie. Use at least 16 random characters.
AUTH_SECRET=change-me-to-a-long-random-string

# Seeded control-room operator.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=heist-control
